{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    },
    "logLevel": {
      "Default": "Warning",
      "MudakAI": "Information",
      "Azure.Storage": "Error",
      "Azure.Core": "Error",
      "Microsoft.Azure.WebJobs.Extensions.ServiceBus": "Warning",
      "Function": "Information",
      "Host.Triggers": "Warning"
    }
  }
}